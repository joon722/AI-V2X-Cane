# RSU 브리지 ESP32의 USB-UART 칩을 /dev/v2x-rsu 고정 이름으로 연결.
# 부팅 순서에 따라 ttyUSB0/ttyUSB1이 뒤바뀌는 문제를 막는다.
# ESP32 보드에서 흔한 세 가지 칩을 모두 등록한다.
# ID_MM_DEVICE_IGNORE=1: ModemManager가 이 포트를 모뎀으로 착각해 열어보는 것을 차단.

# Silicon Labs CP2102/CP2104
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="v2x-rsu", ENV{ID_MM_DEVICE_IGNORE}="1"
# WCH CH340/CH341
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="v2x-rsu", ENV{ID_MM_DEVICE_IGNORE}="1"
# FTDI FT232
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="v2x-rsu", ENV{ID_MM_DEVICE_IGNORE}="1"
